<mxfile host="app.diagrams.net" pages="3">
  <diagram name="Class Diagram" id="KY9DNjJ70NRWq06yiDF9">
    <mxGraphModel dx="2619" dy="2371" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle HVHRS - Class Diagram\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nhide empty members\n\nclass Guest {\n  - guestId: String\n  - fullName: String\n  - email: String\n  - phone: String\n  + updateDetails(name: String, email: String, phone: String): void\n}\n\nclass Room {\n  - roomNumber: String\n  - status: String\n  + isAvailable(startDate: Date, endDate: Date): Boolean\n}\n\nclass RoomType {\n  - typeId: String\n  - typeName: String\n  - description: String\n  + getRate(startDate: Date): Money\n}\n\nclass SeasonalRate {\n  - rateId: String\n  - startDate: Date\n  - endDate: Date\n  - nightlyRate: Money\n  + appliesTo(date: Date): Boolean\n}\n\nclass Reservation {\n  - confirmationNumber: String\n  - createdAt: DateTime\n  - checkInDate: Date\n  - checkOutDate: Date\n  - status: ReservationStatus\n  - totalAmount: Money\n  - actualCheckInTime: DateTime\n  - actualCheckOutTime: DateTime\n  + addRoom(room: Room): void\n  + calculateTotal(): Money\n  + confirm(): void\n  + cancel(): Boolean\n  + checkIn(): void\n  + checkOut(): Money\n}\n\nenum ReservationStatus {\n  Created\n  Confirmed\n  CheckedIn\n  CheckedOut\n  Canceled\n}\n\nclass Payment {\n  - paymentId: String\n  - amount: Money\n  - status: PaymentStatus\n  - transactionReference: String\n  + markAuthorized(reference: String): void\n  + markDeclined(): void\n}\n\nenum PaymentStatus {\n  Pending\n  Authorized\n  Declined\n}\n\nclass PaymentInfo {\n  - token: String\n  - cardholderName: String\n}\n\ninterface PaymentGateway {\n  + authorize(info: PaymentInfo, amount: Money): AuthorizationResult\n}\n\nenum AuthorizationResult {\n  Authorized\n  Declined\n}\n\nclass ReservationService {\n  + searchAvailableRooms(startDate: Date, endDate: Date, roomType: RoomType): List&lt;Room&gt;\n  + createReservation(guest: Guest, room: Room, startDate: Date, endDate: Date): Reservation\n  + requestPaymentAuthorization(payment: Payment, info: PaymentInfo): AuthorizationResult\n}\n\nclass NotificationService {\n  + sendConfirmation(guest: Guest, reservation: Reservation): void\n  + notifyPaymentFailure(guest: Guest, reservation: Reservation): void\n}\n\nclass OccupancyReport {\n  - startDate: Date\n  - endDate: Date\n  - occupancyPercentage: Decimal\n  - totalRevenue: Money\n  + generate(): void\n}\n\nGuest \&quot;1\&quot; -- \&quot;0..*\&quot; Reservation : owns\nReservation \&quot;0..*\&quot; -- \&quot;1..*\&quot; Room : reserves\nRoomType \&quot;1\&quot; -- \&quot;0..*\&quot; Room : classifies\nRoomType \&quot;1\&quot; *-- \&quot;1..*\&quot; SeasonalRate : rates\nReservation \&quot;1\&quot; -- \&quot;0..*\&quot; Payment : payments\nPaymentInfo ..&gt; PaymentGateway : authorization data\nReservationService ..&gt; Room : checks availability\nReservationService ..&gt; Reservation : creates\nReservationService ..&gt; PaymentGateway : requests authorization\nReservationService ..&gt; NotificationService : sends notifications\nReservationService ..&gt; RoomType : obtains rates\nOccupancyReport ..&gt; Reservation : reads\nOccupancyReport ..&gt; Room : reads\n\nnote right of Reservation\n  {confirmationNumber is unique}\n  {at least one room per reservation}\n  Cancellation allowed only in\n  Created or Confirmed.\nend note\n\nnote bottom of SeasonalRate\n  Rate periods for a room type\n  must not overlap ambiguously.\nend note\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="07HxO1C1P7sb7wrTZUQq-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
