        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle HVHRS - Online Reservation Sequence\nautonumber\nskinparam shadowing false\n\nactor Guest\nparticipant \&quot;service:ReservationService\&quot; as Service\nparticipant \&quot;room:Room\&quot; as Room\nparticipant \&quot;reservation:Reservation\&quot; as Reservation\nparticipant \&quot;payment:Payment\&quot; as Payment\nparticipant \&quot;gateway:PaymentGateway\&quot; as Gateway\nparticipant \&quot;notifications:NotificationService\&quot; as Notify\n\nGuest -&gt; Service : searchAvailableRooms(startDate, endDate, roomType)\nactivate Service\nService -&gt; Room : isAvailable(startDate, endDate)\nactivate Room\nRoom --&gt; Service : available\ndeactivate Room\nService --&gt; Guest : availableRooms and nightlyRates\ndeactivate Service\n\nGuest -&gt; Service : createReservation(guest, room, startDate, endDate)\nactivate Service\nService -&gt; Room : isAvailable(startDate, endDate)\nactivate Room\nRoom --&gt; Service : availabilityResult\ndeactivate Room\n\nalt Room unavailable\n  Service --&gt;&gt; Guest : notify room unavailable\n  Service --&gt;&gt; Guest : display available alternatives\nelse Room available\n  Service -&gt; Reservation : createReservation(guest, room, dates)\n  activate Reservation\n  Reservation --&gt; Service : reservationCreated(Created)\n  Service -&gt; Reservation : addRoom(room)\n  Reservation --&gt; Service : roomAdded\n  Service -&gt; Reservation : calculateTotal()\n  Reservation --&gt; Service : totalAmount\n\n  Service -&gt; Service : createPayment(reservation, totalAmount)\n  create Payment\n  Service -&gt; Payment : Payment(totalAmount)\n  activate Payment\n  Payment --&gt; Service : paymentCreated(Pending)\n  deactivate Payment\n\n  Service -&gt; Gateway : authorize(paymentInfo, totalAmount)\n  activate Gateway\n  Gateway --&gt; Service : authorizationResult\n  deactivate Gateway\n\n  alt Authorized\n    Service -&gt; Payment : markAuthorized(reference)\n    activate Payment\n    Payment --&gt; Service : paymentRecorded\n    deactivate Payment\n\n    Service -&gt; Reservation : confirm()\n    Reservation --&gt; Service : status = Confirmed\n\n    Service --&gt;&gt; Notify : sendConfirmation(guest, reservation)\n    activate Notify\n    Notify --&gt;&gt; Guest : confirmation details\n    deactivate Notify\n  else Declined\n    Service -&gt; Payment : markDeclined()\n    activate Payment\n    Payment --&gt; Service : paymentRecorded\n    deactivate Payment\n\n    Service --&gt;&gt; Notify : notifyPaymentFailure(guest, reservation)\n    activate Notify\n    Notify --&gt;&gt; Guest : payment authorization failed\n    deactivate Notify\n\n    note right of Reservation\n      Reservation remains Created.\n    end note\n  end\n  deactivate Reservation\nend\n\ndeactivate Service\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hbk2gkjgEfUvYKnv6JsQ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
